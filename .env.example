# Получите токен у @BotFather и не добавляйте настоящий токен в Git.
BOT_TOKEN=replace_with_your_telegram_bot_token

# Необязательные настройки. Пути считаются от корня проекта.
DATABASE_PATH=data/bot.db
GUIDE_PATH=documents/python-backend-roadmap.pdf

# Ключ сервисного аккаунта Google. Настоящие значения не добавляйте в Git.
# В GOOGLE_PRIVATE_KEY оставляйте перевод строки как символы \n.
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_X509_CERT_URL=
# Идентификатор таблицы из адреса: /spreadsheets/d/этот_ид/edit
GOOGLE_SPREADSHEET_ID=
# Имя листа. Если пусто, бот пишет на первый лист таблицы.
GOOGLE_WORKSHEET_NAME=
